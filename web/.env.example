# Copy to .env.local (never commit it). Everything is optional: a source without its key shows as "not configured" and is skipped.

# Contact details sent to public APIs (Wikipedia User-Agent, Crossref/OpenAlex polite pool, Unpaywall).
HTTP_USER_AGENT="origincheck/0.2 (contact: you@example.com)"
CONTACT_EMAIL=you@example.com
# Unpaywall rejects placeholder addresses: use a real one or Unpaywall is skipped.
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Web search
BRAVE_API_KEY=
JINA_API_KEY=
# Google Books: search inside books (free key from the Google Cloud console; falls back to GOOGLE_API_KEY)
GOOGLE_BOOKS_API_KEY=

# Translation of search phrases for documents not in English (self-hosted LibreTranslate, or libretranslate.com + key)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Scholarly sources: CORE needs its free key; Semantic Scholar works without one but is usually rate-limited
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional, existing customers only: Google closed Programmable Search to new customers and shuts it down on 2027-01-01.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Paid plagiarism check (Copyleaks). Sends the whole document to Copyleaks; results arrive by webhook,
# so PUBLIC_BASE_URL must be reachable from the internet (an ngrok tunnel locally; Vercel's URL by default).
COPYLEAKS_EMAIL=
COPYLEAKS_KEY=
COPYLEAKS_SANDBOX=false
PUBLIC_BASE_URL=

# "Improve my writing" (choose one provider)
AI_PROVIDER=anthropic        # anthropic | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Feature flags
ENABLE_AI_LIKELIHOOD=false
ENABLE_LANGUAGETOOL=false
LANGUAGETOOL_URL=http://localhost:8010

# Limits
SEARCH_MAX_QUERIES=8
