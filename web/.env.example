# Copy to .env.local (never commit it), or set these on the app's Settings page. Everything is optional: a source
# without its key shows as "not configured" and is skipped. No pay-as-you-go API is on unless its key is set, and each
# has a monthly cap: when it's reached, origincheck stops calling it (usage is shown in Settings).

# Contact details sent to public APIs (Wikipedia User-Agent, Crossref/OpenAlex polite pool, Unpaywall).
HTTP_USER_AGENT="origincheck/0.2 (contact: you@example.com)"
CONTACT_EMAIL=you@example.com
# Unpaywall rejects placeholder addresses: use a real one or Unpaywall is skipped.
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Web search. Tavily is the default: free plan (1,000 credits/month), no card, requests stop when credits run out.
TAVILY_API_KEY=
TAVILY_MONTHLY_CREDIT_CAP=900
# Brave: optional. A card is required and use beyond the monthly free credit is billed automatically,
# so it is off unless set and capped here. Its results are never cached (Brave's terms).
BRAVE_API_KEY=
BRAVE_MONTHLY_QUERY_CAP=800
JINA_API_KEY=
# Google Books: search inside books (free key from the Google Cloud console; falls back to GOOGLE_API_KEY)
GOOGLE_BOOKS_API_KEY=
# Optional, existing customers only: Google closed Programmable Search to new customers and shuts it down on 2027-01-01.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Scholarly sources: CORE needs its free key; Semantic Scholar works without one but is usually rate-limited
CORE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Translation of search phrases for documents not in English (self-hosted LibreTranslate, or libretranslate.com + key)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Paid plagiarism check (Copyleaks). Sends the whole document to Copyleaks; results arrive by webhook,
# so PUBLIC_BASE_URL must be reachable from the internet (an ngrok tunnel locally; Vercel's URL by default).
COPYLEAKS_EMAIL=
COPYLEAKS_KEY=
COPYLEAKS_SANDBOX=false
COPYLEAKS_MONTHLY_SCAN_CAP=20
PUBLIC_BASE_URL=

# Rewrite ("Improve my writing"). Default: a free local model through Ollama (install from ollama.com, then
# run `ollama pull phi4-mini`); the text stays on this machine. Anthropic only if chosen here, capped per month.
AI_PROVIDER=ollama           # ollama | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini       # Microsoft Phi-4-mini, MIT licence
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MONTHLY_REQUEST_CAP=500

# Feature flags
ENABLE_AI_LIKELIHOOD=false
ENABLE_LANGUAGETOOL=false
LANGUAGETOOL_URL=http://localhost:8010

# Limits
SEARCH_MAX_QUERIES=8
# Where monthly usage counts are kept (default web/.data/usage.json, git-ignored)
# USAGE_FILE=
